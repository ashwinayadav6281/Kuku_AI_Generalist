# Kuku Promo Finder Environment Configuration
# Copy this file to .env and insert your API keys

# Gemini Free Tier (Default Provider)
GEMINI_API_KEY=your_gemini_api_key_here
# Alternative alias recognized:
# GOOGLE_API_KEY=your_gemini_api_key_here

# OpenAI or OpenAI-Compatible Endpoints (Optional)
OPENAI_API_KEY=your_openai_api_key_here
# Custom Base URL for OpenRouter, Groq, local Ollama, vLLM:
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (Optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Provider Override (optional, overrides config.yaml)
# LLM_PROVIDER=gemini
